RESOURCE DIALOG r_tgpager_write_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = ETgPagerQueryMsg;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                control = EDWIN
                    {
                    flags = EEikEdwinNoHorizScrolling | EEikEdwinResizable;
                    width = 10;
                    maxlength = 200;
