TARGET            TgPager.app
TARGETTYPE        app

// Change the second number here to change the UID for this application
UID               0x100039CE 0x70000072
TARGETPATH        \system\apps\tgpager

SOURCEPATH        ..\src
SOURCE            TgPager.cpp
SOURCE            TgPagerApplication.cpp
SOURCE            TgPagerAppView.cpp
SOURCE            TgPagerAppUi.cpp
SOURCE            TgPagerDocument.cpp
SOURCE            TgPagerEngine.cpp
SOURCE            TgSettings.cpp

SOURCEPATH        ..\data
RESOURCE          TgPager.rss
RESOURCE          TgPager_caption.rss

USERINCLUDE       ..\inc

SYSTEMINCLUDE     \epoc32\include

LIBRARY           euser.lib
LIBRARY           efsrv.lib
LIBRARY           apparc.lib
LIBRARY           cone.lib
LIBRARY           eikcore.lib
LIBRARY           avkon.lib
LIBRARY           commonengine.lib
LIBRARY           eikcoctl.lib
LIBRARY           eikctl.lib
LIBRARY           bafl.lib
LIBRARY           insock.lib
LIBRARY           esock.lib

LANG SC


AIF             TgPager.aif ..\aif tgpagerAif.rss c12 qgn_menu_demo_cxt.bmp qgn_menu_demo_cxt_mask.bmp qgn_menu_demo_lst.bmp qgn_menu_demo_lst_mask.bmp

// End of File
