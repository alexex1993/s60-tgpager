#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include "HelloN70.hrh"
#include "HelloN70.loc"

//  RESOURCE DEFINITIONS
// -----------------------------------------------------------------------------
//
//    Define the resource file signature
//    This resource should be empty.
//
// -----------------------------------------------------------------------------
//
RESOURCE RSS_SIGNATURE
    {
    }

// -----------------------------------------------------------------------------
//
//    Default Document Name
//
// -----------------------------------------------------------------------------
//
RESOURCE TBUF r_default_document_name
    {
    buf="HEWB";
    }

// -----------------------------------------------------------------------------
//
//    Define default menu and CBA key.
//
// -----------------------------------------------------------------------------
//
RESOURCE EIK_APP_INFO
    {
    menubar = r_hellon70_menubar;
    cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
    }


// -----------------------------------------------------------------------------
//
//   r_hellon70_menubar
//   Menubar for HelloN70 example
//
// -----------------------------------------------------------------------------
//
RESOURCE MENU_BAR r_hellon70_menubar
    {
    titles =
        {
        MENU_TITLE { menu_pane = r_hellon70_menu; }
        };
    }


// -----------------------------------------------------------------------------
//
//   r_hellon70_menu
//   Menu for "Options"
//
// -----------------------------------------------------------------------------
//
RESOURCE MENU_PANE r_hellon70_menu
    {
    items =
        {
        // added the new Options menu command here
        MENU_ITEM
                {
                command = EHelloN70Command1;
                txt = qtn_hewb_command1;
                },
        MENU_ITEM
                {
                command = EAknSoftkeyExit;
                txt = qtn_hewb_exit;
                }
        };
    }

// -----------------------------------------------------------------------------
//
// Resources for messages.
//
// -----------------------------------------------------------------------------
//
RESOURCE TBUF32 r_hewb_command1_text { buf=qtn_hewb_command1_text; }
RESOURCE TBUF32 r_hewb_caption_string { buf=qtn_hewb_caption_string; }

